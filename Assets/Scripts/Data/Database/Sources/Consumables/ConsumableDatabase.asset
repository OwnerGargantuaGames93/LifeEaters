  Items:
  - Name: Heartleaf
    Description: A thin, fragrant leaf that grows on young branches. Chewing it releases
      a mild healing essence.
    ShortDescription: A thin, fragrant leaf that grows on young branches.
    GamePlayDescription: Restore 1 HP
    SmallIcon: {fileID: 21300000, guid: 2aaae095691394bc0bd15635cc64f5f6, type: 3}
