    Icon: {fileID: 0}
    ShopDescriptions: []
    id: 1
    type: 0
    turnOutEarn: 0
    generations:
    - id: 1
      chance: 30
  - Name: Miner Essence
    Description: "Mining is the most common job around here. It doesn\u2019t require
      any particular academic skills, and the pay is very good."
    ShortDescription: Essence of a Life grown within a miner.
    GamePlayDescription: 
    SmallIcon: {fileID: 0}
    Icon: {fileID: 0}
